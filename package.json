{
  "name": "mkv.js",
  "version": "1.0.0",
  "description": "browser MKV demuxer and player library",
  "main": "src/index.js",
  "scripts": {
    "test": "standard && vitest run",
    "test:unit": "vitest run",
    "build": "browserify src/browser/demo.js | google-closure-compiler-js > dist/main.js",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgustavor/mkv-extract.git"
  },
  "keywords": [
    "mkv",
    "matroska",
    "video",
    "player",
    "browser",
    "demuxer",
    "subtitles"
  ],
  "author": "qgustavor (https://qgustavor.tk)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qgustavor/mkv-extract/issues"
  },
  "homepage": "https://github.com/qgustavor/mkv-extract#readme",
  "private": false,
  "standard": {
    "ignore": [
      "dist/main.js"
    ]
  },
  "devDependencies": {
    "browserify": "^14.5.0",
    "gh-pages": "^2.0.1",
    "google-closure-compiler-js": "^20170423.0.0",
    "standard": "^12.0.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "ebml": "^2.2.4",
    "filereader-stream": "^1.0.0",
    "progress-stream": "^2.0.0"
  }
}
