{
  "name": "mkv.js",
  "version": "1.0.0",
  "description": "Web-based mkv video player",
  "scripts": {
    "test": "standardx src/*.ts",
    "dev": "parcel src/index.html",
    "build": "parcel build src/index.html --experimental-scope-hoisting --public-url /mkv.js/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizath/mkv.js.git"
  },
  "keywords": [
    "mkv",
    "browser"
  ],
  "author": "faizath (github.com/faizath)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/faizath/mkv.js/issues"
  },
  "homepage": "https://github.com/faizath/mkv.js",
  "private": true,
  "eslintConfig": {
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "error"
    }
  },
  "standardx": {
    "parser": "@typescript-eslint/parser",
    "plugins": [ "@typescript-eslint/eslint-plugin" ]
  },
  "devDependencies": {
    "@types/ebml": "^3.0.0",
    "@types/progress-stream": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^3.0.2",
    "@typescript-eslint/parser": "^3.0.2",
    "parcel-bundler": "^1.12.4",
    "standardx": "^5.0.0",
    "typescript": "^3.9.3"
  },
  "dependencies": {
    "ebml": "^2.2.4",
    "filereader-stream": "^1.0.0",
    "progress-stream": "^2.0.0",
    "promisepipe": "^3.0.0"
  }
}
