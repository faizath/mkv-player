{
  "name": "mkv.js",
  "version": "2.2.0",
  "description": "browser MKV demuxer and player library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "mkv.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "standard && vitest run",
    "test:unit": "vitest run",
    "build": "tsup --entry.index=src/index.js --entry.browser=src/browser/index.js --format esm,cjs --out-dir dist && tsup --config tsup.browser.config.js --entry.mkv=src/browser/index.js --format iife --global-name mkvjs --out-dir dist/iife && tsup --config tsup.browser.config.js --entry.mkv-worker=src/worker/mkv-worker.js --format esm --out-dir dist/worker && cp dist/iife/mkv.global.js mkv.js && mkdir -p dist/examples && cp examples/*.html dist/examples/ && cp src/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgustavor/mkv-extract.git"
  },
  "keywords": [
    "mkv",
    "matroska",
    "video",
    "player",
    "browser",
    "demuxer",
    "subtitles"
  ],
  "author": "qgustavor (https://qgustavor.tk)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qgustavor/mkv-extract/issues"
  },
  "homepage": "https://github.com/qgustavor/mkv-extract#readme",
  "private": false,
  "standard": {
    "ignore": [
      "dist",
      "mkv.js"
    ]
  },
  "devDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "akarisub": "^1.1.3",
    "gh-pages": "^2.0.1",
    "libbitsub": "^1.12.1",
    "standard": "^12.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "ebml": "^2.2.4",
    "events": "^3.3.0",
    "filereader-stream": "^1.0.0",
    "process": "^0.11.10",
    "progress-stream": "^2.0.0",
    "srt2vtt": "file:../srt2vtt.js",
    "stream-browserify": "^3.0.0",
    "tty-browserify": "^0.0.1",
    "util": "^0.12.5"
  },
  "peerDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "akarisub": "^1.1.0",
    "libbitsub": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/ffmpeg": {
      "optional": true
    },
    "@ffmpeg/util": {
      "optional": true
    },
    "akarisub": {
      "optional": true
    },
    "libbitsub": {
      "optional": true
    }
  }
}
